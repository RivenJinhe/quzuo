# 复制为 .env.prod 后填写。上线前请确认：cookie_secure=false（用 http://IP:8010 访问时必须 false）
QU_LLM_ALLOW_REAL=true
QU_LLM_DEFAULT_MODEL=deepseek/deepseek-chat
QU_LLM_TIMEOUT_SECONDS=180

# 四家模型（至少填 DeepSeek，其余可留空）
QU_PROVIDER_DEEPSEEK_KEY=
QU_PROVIDER_KIMI_KEY=
QU_PROVIDER_QWEN_KEY=
QU_PROVIDER_MINIMAX_KEY=

# 试用与限流
QU_TRIAL_TTL_DAYS=30
QU_TRIAL_PURGE_DAYS=37
QU_GEN_RATE_PER_MINUTE=6

# 关键：用 IP + 非 443 端口访问 = http，必须 false，否则登录 cookie 不生效
QU_COOKIE_SECURE=false

# 若改用 Neon 等外部库，把下面这行改写并注释掉 compose 里对 db 的依赖
# QU_DATABASE_URL=postgresql+psycopg://neondb_owner:密码@ep-xxx-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require
