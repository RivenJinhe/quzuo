# 复制成 .env 后填写。key 只放服务端，任何接口都不会返回。

# 从后端目录启动时，SQLite 文件会保存在该目录下。
QU_DATABASE_URL=sqlite:///./qu_dev.sqlite3
# 使用 PostgreSQL 时，将上面的连接串替换为实际连接串，例如：
# QU_DATABASE_URL=postgresql+psycopg://qu:qu@127.0.0.1:55432/qu_dev

# 是否允许调用真实模型。false = 只用内置 stub（不联网、不花钱，仅用于跑通流程）
QU_LLM_ALLOW_REAL=true
# 默认模型，取值见 GET /api/v1/models
QU_LLM_DEFAULT_MODEL=deepseek/deepseek-chat
QU_LLM_TIMEOUT_SECONDS=180

# 各家 key，留空则该模型在 /api/v1/models 里显示为不可用
QU_PROVIDER_DEEPSEEK_KEY=
QU_PROVIDER_KIMI_KEY=
QU_PROVIDER_QWEN_KEY=
QU_PROVIDER_MINIMAX_KEY=

# 试用身份（游客）有效期，单位天
QU_TRIAL_TTL_DAYS=30
QU_TRIAL_PURGE_DAYS=37
# 线上是 HTTPS 时改成 true，本地 http 调试要保持 false
QU_COOKIE_SECURE=false

# 生成限流（每身份每分钟次数）
QU_GEN_RATE_PER_MINUTE=6
